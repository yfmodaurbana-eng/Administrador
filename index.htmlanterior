<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>STRANGIS · Administrador</title>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<style>
/* =========================================================
   RESET
========================================================= */

*{
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    margin:0;
    background:#f3f3f1;
    color:#111;
    font-family:Arial,Helvetica,sans-serif;
    font-size:13px;
}

button,
input,
textarea{
    font:inherit;
}

button{
    cursor:pointer;
}

img{
    max-width:100%;
}


/* =========================================================
   HEADER
========================================================= */

header{
    min-height:72px;
    padding:0 30px;
    background:#111;
    color:#fff;

    display:flex;
    align-items:center;
    justify-content:space-between;

    gap:20px;
}

.logo{
    font-size:24px;
    font-weight:900;
    letter-spacing:4px;
}

.header-status{
    display:flex;
    align-items:center;
    gap:20px;

    font-size:10px;
    letter-spacing:1.5px;
    color:#aaa;
}


/* =========================================================
   LOGIN
========================================================= */

.login-overlay{
    position:fixed;
    inset:0;
    z-index:9999;

    background:#111;

    display:flex;
    align-items:center;
    justify-content:center;

    padding:20px;
}

.login-overlay.hidden{
    display:none;
}

.login-box{
    width:100%;
    max-width:430px;

    background:#fff;
    padding:40px;

    border:1px solid #ddd;
}

.login-logo{
    font-size:30px;
    font-weight:900;
    letter-spacing:5px;
    margin-bottom:8px;
}

.login-subtitle{
    color:#777;
    font-size:10px;
    letter-spacing:1.5px;
    margin-bottom:30px;
}

.login-field{
    margin-bottom:18px;
}

.login-field label{
    display:block;
    margin-bottom:7px;

    font-size:10px;
    font-weight:bold;
    text-transform:uppercase;
    letter-spacing:1px;
}

.login-field input{
    width:100%;
    padding:14px;

    border:1px solid #ccc;
    background:#fafafa;
    outline:none;
}

.login-field input:focus{
    border-color:#111;
    background:#fff;
}

.login-button{
    width:100%;
    padding:15px;

    border:0;
    background:#111;
    color:#fff;

    font-weight:bold;
    letter-spacing:1px;
}

.login-button:disabled{
    opacity:.5;
    cursor:not-allowed;
}

.login-error{
    min-height:20px;
    margin-bottom:12px;

    color:#b00020;
    font-size:12px;
}


/* =========================================================
   LAYOUT
========================================================= */

.container{
    width:min(1500px, calc(100% - 40px));
    margin:0 auto;
    padding:45px 0 80px;
}

.page-title{
    margin-bottom:35px;
}

.page-title small{
    display:block;

    color:#777;
    font-size:10px;
    font-weight:bold;
    letter-spacing:2px;
}

.page-title h1{
    margin:7px 0;

    font-size:42px;
    line-height:1;
    letter-spacing:-2px;
}

.page-title p{
    max-width:700px;

    margin:14px 0 0;

    color:#666;
    line-height:1.6;
}

.admin-grid{
    display:grid;
    grid-template-columns:minmax(0, 1fr) 430px;
    gap:30px;
    align-items:start;
}


/* =========================================================
   PANELS
========================================================= */

.panel{
    background:#fff;
    border:1px solid #ddd;
    padding:25px;
}

.panel + .panel{
    margin-top:25px;
}

.panel-title{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;

    margin-bottom:20px;
}

.panel-title h2{
    margin:0;

    font-size:15px;
    text-transform:uppercase;
    letter-spacing:.5px;
}

.panel-title span{
    color:#999;
    font-size:9px;
    letter-spacing:1px;
}


/* =========================================================
   BUTTONS
========================================================= */

.btn{
    min-height:40px;
    padding:0 16px;

    border:1px solid #111;
    background:#fff;
    color:#111;

    font-size:10px;
    font-weight:bold;
    letter-spacing:.7px;
}

.btn:hover{
    background:#111;
    color:#fff;
}

.btn:disabled{
    opacity:.45;
    cursor:not-allowed;
}

.btn-small{
    min-height:32px;
    padding:0 11px;
    font-size:9px;
}

.btn-primary{
    background:#111;
    color:#fff;
}

.btn-primary:hover{
    background:#333;
}

.btn-danger{
    border-color:#b00020;
    color:#b00020;
}

.btn-danger:hover{
    background:#b00020;
    color:#fff;
}


/* =========================================================
   PRODUCTS LIST
========================================================= */

.products-list{
    display:flex;
    flex-direction:column;
    gap:10px;
}

.products-loading,
.products-empty{
    padding:30px;
    text-align:center;
    color:#888;
    border:1px dashed #ccc;
}

.product-admin-item{
    display:grid;
    grid-template-columns:70px minmax(0,1fr) auto;
    align-items:center;

    gap:15px;

    padding:12px;

    border:1px solid #e2e2e2;
    background:#fafafa;
}

.product-admin-image{
    width:70px;
    height:80px;

    background:#e7e7e5;

    display:flex;
    align-items:center;
    justify-content:center;

    overflow:hidden;
}

.product-admin-image img{
    width:100%;
    height:100%;
    object-fit:cover;
}

.product-admin-name{
    font-weight:bold;
    margin-bottom:7px;
}

.product-admin-meta{
    color:#666;
    font-size:10px;
    line-height:1.7;
}

.product-admin-id{
    margin-top:5px;
    color:#aaa;
    font-size:9px;
    word-break:break-all;
}

.product-admin-actions{
    display:flex;
    gap:7px;
    flex-wrap:wrap;
    justify-content:flex-end;
}


/* =========================================================
   EDIT MODE
========================================================= */

.mode-bar{
    display:none;

    margin-top:20px;
    padding:15px 18px;

    background:#111;
    color:#fff;

    align-items:center;
    justify-content:space-between;
    gap:20px;
}

.mode-bar.show{
    display:flex;
}

#editModeTitle{
    font-size:12px;
}

#editModeId{
    color:#aaa;
    font-size:9px;
}


/* =========================================================
   FORM
========================================================= */

.form-grid{
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:18px;
}

.field{
    min-width:0;
}

.field.full{
    grid-column:1 / -1;
}

.field label{
    display:block;

    margin-bottom:7px;

    font-size:9px;
    font-weight:bold;
    text-transform:uppercase;
    letter-spacing:1px;
    color:#555;
}

.field input,
.field textarea{
    width:100%;

    padding:12px;

    border:1px solid #ccc;
    background:#fafafa;

    outline:none;
}

.field input:focus,
.field textarea:focus{
    border-color:#111;
    background:#fff;
}

.field textarea{
    min-height:120px;
    resize:vertical;
}


/* =========================================================
   SIZES
========================================================= */

.sizes-list{
    display:flex;
    flex-wrap:wrap;
    gap:8px;
}

.size-item{
    display:flex;
    gap:5px;
}

.size-item input{
    width:100px;

    padding:10px;

    border:1px solid #ccc;
}

.remove-size{
    width:35px;

    border:1px solid #ccc;
    background:#fff;
}

.remove-size:hover{
    background:#111;
    color:#fff;
}


/* =========================================================
   VARIANTS
========================================================= */

.variants-list{
    display:flex;
    flex-direction:column;
    gap:18px;
}

.variant{
    padding:18px;
    border:1px solid #ddd;
    background:#fafafa;
}

.variant-top{
    display:grid;
    grid-template-columns:50px minmax(0,1fr) auto;
    align-items:end;
    gap:15px;
}

.color-picker{
    width:45px;
    height:45px;

    border:1px solid #ccc;

    overflow:hidden;
}

.color-picker input{
    width:100%;
    height:100%;
    padding:0;
    border:0;
    background:transparent;
    cursor:pointer;
}

.variant-image-list{
    margin-top:18px;

    display:flex;
    flex-direction:column;
    gap:10px;
}

.variant-image-row{
    display:grid;
    grid-template-columns:minmax(0,1fr) 90px auto;
    gap:10px;
    align-items:end;
}

.variant-preview{
    width:90px;
    height:90px;

    background:#e6e6e4;

    display:flex;
    align-items:center;
    justify-content:center;

    overflow:hidden;
}

.variant-preview img{
    width:100%;
    height:100%;
    object-fit:cover;
}

.add-photo{
    margin-top:12px;
}


/* =========================================================
   CODE
========================================================= */

.code-panel{
    margin-top:25px;
}

.code-output{
    display:block;

    width:100%;
    min-height:350px;

    padding:15px;

    background:#111;
    color:#ddd;

    border:0;
    outline:none;

    font-family:
        Consolas,
        Monaco,
        monospace;

    font-size:11px;
    line-height:1.6;

    resize:vertical;
}

.actions{
    display:flex;
    flex-wrap:wrap;
    gap:8px;

    margin-top:15px;
}


/* =========================================================
   PREVIEW
========================================================= */

.preview-wrap{
    position:sticky;
    top:20px;
}

.preview-label{
    margin-bottom:10px;

    color:#777;
    font-size:9px;
    font-weight:bold;
    letter-spacing:1.5px;
}

.product-card{
    background:#fff;
    border:1px solid #ddd;
}

.preview-image{
    position:relative;

    height:430px;

    background:#e8e8e6;

    display:flex;
    align-items:center;
    justify-content:center;

    overflow:hidden;
}

.preview-image img{
    width:100%;
    height:100%;
    object-fit:cover;

    cursor:zoom-in;
}

.preview-arrows{
    position:absolute;
    inset:0;

    display:flex;
    align-items:center;
    justify-content:space-between;

    pointer-events:none;
}

.preview-arrows button{
    pointer-events:auto;

    width:40px;
    height:40px;

    border:0;
    background:rgba(255,255,255,.8);

    font-size:30px;
    line-height:1;
}

.photo-counter{
    position:absolute;
    right:12px;
    bottom:12px;

    padding:5px 8px;

    background:rgba(0,0,0,.7);
    color:#fff;

    font-size:9px;
}

.zoom-hint{
    position:absolute;
    left:12px;
    bottom:12px;

    padding:5px 8px;

    background:rgba(255,255,255,.85);

    font-size:8px;
    letter-spacing:1px;
}

.preview-thumbs{
    display:flex;
    gap:6px;

    padding:10px;

    overflow-x:auto;
}

.preview-thumb{
    flex:0 0 55px;

    width:55px;
    height:65px;

    padding:0;

    border:2px solid transparent;
    background:#eee;
}

.preview-thumb.active{
    border-color:#111;
}

.preview-thumb img{
    width:100%;
    height:100%;
    object-fit:cover;
}

.preview-content{
    padding:22px;
}

.preview-name{
    font-size:19px;
    font-weight:bold;
}

.preview-ref{
    margin-top:5px;

    color:#999;
    font-size:9px;
}

.preview-description{
    margin-top:18px;

    color:#666;
    font-size:11px;
    line-height:1.6;
}

.preview-price{
    margin-top:18px;

    font-size:24px;
    font-weight:bold;
}

.preview-label-row{
    margin-top:20px;
    margin-bottom:9px;

    font-size:10px;
    font-weight:bold;
    text-transform:uppercase;
    letter-spacing:.5px;
}

.preview-colors{
    display:flex;
    flex-wrap:wrap;
    gap:8px;
}

.preview-color{
    width:30px;
    height:30px;

    border-radius:50%;
    border:2px solid #ddd;

    background-size:cover;
    background-position:center;
}

.preview-color.active{
    outline:2px solid #111;
    outline-offset:2px;
}

.preview-sizes{
    display:flex;
    flex-wrap:wrap;
    gap:7px;
}

.preview-size{
    min-width:40px;

    padding:9px;

    border:1px solid #ccc;
    background:#fff;
}

.preview-size.active{
    background:#111;
    color:#fff;
}

.preview-quantity{
    display:flex;
    align-items:center;

    width:max-content;

    margin-top:20px;

    border:1px solid #ccc;
}

.preview-quantity button{
    width:38px;
    height:35px;

    border:0;
    background:#fff;

    font-size:18px;
}

.preview-quantity span{
    width:40px;
    text-align:center;
}

.shipping-box{
    display:flex;
    gap:10px;
    align-items:center;

    margin-top:20px;
    padding:13px;

    background:#f3f3f1;
}

.shipping-icon{
    font-size:20px;
}

.shipping-text{
    color:#777;
    font-size:8px;
    letter-spacing:1px;
}

.shipping-text strong{
    display:block;
    margin-top:4px;

    color:#111;
    font-size:11px;
    letter-spacing:0;
}

.preview-buy{
    width:100%;

    margin-top:18px;
    padding:14px;

    border:0;
    background:#111;
    color:#fff;

    font-size:10px;
    font-weight:bold;
    letter-spacing:1px;
}


/* =========================================================
   MODALS
========================================================= */

.delete-modal,
.zoom-modal{
    position:fixed;
    inset:0;

    z-index:8000;

    display:none;

    align-items:center;
    justify-content:center;

    padding:20px;

    background:rgba(0,0,0,.75);
}

.delete-modal.show,
.zoom-modal.show{
    display:flex;
}

.delete-box{
    width:100%;
    max-width:520px;

    padding:25px;

    background:#fff;
}

.delete-warning{
    padding:15px;

    background:#fff0f2;
    color:#700015;

    line-height:1.6;
}

.delete-product-name{
    margin:20px 0;

    font-size:18px;
    font-weight:bold;
}

.delete-actions{
    display:flex;
    justify-content:flex-end;
    gap:8px;
}

.zoom-modal img{
    max-width:92vw;
    max-height:90vh;

    object-fit:contain;
}

.zoom-close{
    position:absolute;
    top:20px;
    right:25px;

    width:45px;
    height:45px;

    border:0;
    background:#fff;

    font-size:30px;
}


/* =========================================================
   TOAST
========================================================= */

.toast{
    position:fixed;
    left:50%;
    bottom:25px;

    z-index:10000;

    transform:
        translate(-50%,20px);

    opacity:0;
    pointer-events:none;

    padding:13px 18px;

    background:#111;
    color:#fff;

    font-size:11px;

    transition:.25s ease;
}

.toast.show{
    transform:
        translate(-50%,0);

    opacity:1;
}

.toast.error{
    background:#b00020;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media(max-width:1050px){

    .admin-grid{
        grid-template-columns:1fr;
    }

    .preview-wrap{
        position:relative;
        top:auto;
    }

}

@media(max-width:700px){

    header{
        padding:15px 18px;
        align-items:flex-start;
        flex-direction:column;
    }

    .header-status{
        width:100%;
        justify-content:space-between;
    }

    .container{
        width:min(100% - 24px, 1500px);
        padding-top:30px;
    }

    .page-title h1{
        font-size:34px;
    }

    .panel{
        padding:18px;
    }

    .form-grid{
        grid-template-columns:1fr;
    }

    .field.full{
        grid-column:auto;
    }

    .product-admin-item{
        grid-template-columns:55px 1fr;
    }

    .product-admin-image{
        width:55px;
        height:65px;
    }

    .product-admin-actions{
        grid-column:1 / -1;
        justify-content:flex-start;
    }

    .variant-top{
        grid-template-columns:45px 1fr;
    }

    .variant-top > .btn{
        grid-column:1 / -1;
    }

    .variant-image-row{
        grid-template-columns:1fr;
    }

    .variant-preview{
        width:100%;
        height:150px;
    }

    .mode-bar{
        align-items:flex-start;
        flex-direction:column;
    }

    .actions{
        flex-direction:column;
    }

    .actions .btn{
        width:100%;
    }

    .preview-image{
        height:360px;
    }

}

</style>
</head>


<body>


<!-- =========================================================
     LOGIN
========================================================= -->

<div id="loginOverlay" class="login-overlay">

    <form id="loginForm" class="login-box">

        <div class="login-logo">
            STRANGIS
        </div>

        <div class="login-subtitle">
            PANEL DE ADMINISTRACIÓN · SUPABASE
        </div>

        <div class="login-field">

            <label for="loginEmail">
                Correo electrónico
            </label>

            <input
                id="loginEmail"
                type="email"
                autocomplete="username"
                placeholder="admin@ejemplo.com"
                required
            >

        </div>

        <div class="login-field">

            <label for="loginPassword">
                Contraseña
            </label>

            <input
                id="loginPassword"
                type="password"
                autocomplete="current-password"
                placeholder="••••••••"
                required
            >

        </div>

        <div
            id="loginError"
            class="login-error"
        ></div>

        <button
            id="loginButton"
            class="login-button"
            type="submit"
        >
            ENTRAR
        </button>

    </form>

</div>


<!-- =========================================================
     HEADER
========================================================= -->

<header>

    <div class="logo">
        STRANGIS
    </div>

    <div class="header-status">

        <span>
            PANEL DE ADMINISTRACIÓN · SUPABASE
        </span>

        <button
            id="logoutButton"
            type="button"
            class="btn btn-small"
            style="display:none"
        >
            CERRAR SESIÓN
        </button>

    </div>

</header>


<!-- =========================================================
     CONTENIDO
========================================================= -->

<main class="container">

<section class="page-title">

    <small>
        PRODUCT MANAGER
    </small>

    <h1>
        Administrador
    </h1>

    <p>
        Gestiona tus productos directamente desde Supabase.
        Cada producto puede tener múltiples colores,
        fotografías y tallas.
    </p>

</section>


<div class="admin-grid">


<!-- =========================================================
     ADMIN
========================================================= -->

<section>


<!-- PRODUCTOS -->

<div class="panel">

    <div class="panel-title">

        <h2>
            Productos existentes
        </h2>

        <button
            id="refreshProductsButton"
            type="button"
            class="btn btn-small"
        >
            ↻ ACTUALIZAR
        </button>

    </div>

    <div
        id="productsList"
        class="products-list"
    >

        <div class="products-loading">
            Cargando productos...
        </div>

    </div>

</div>


<!-- MODO EDICIÓN -->

<div
    id="editModeBar"
    class="mode-bar"
>

    <div>

        <strong id="editModeTitle">
            Editando producto
        </strong>

        <br>

        <span id="editModeId"></span>

    </div>

    <button
        id="newFromEditButton"
        type="button"
        class="btn btn-small"
    >
        + NUEVO PRODUCTO
    </button>

</div>


<!-- INFORMACIÓN -->

<div class="panel">

    <div class="panel-title">

        <h2>
            Información del producto
        </h2>

        <span>
            DATOS PRINCIPALES
        </span>

    </div>

    <div class="form-grid">

        <div class="field full">

            <label>
                Nombre del producto
            </label>

            <input
                id="productName"
                type="text"
                placeholder="Ej: Camiseta Oversize Premium"
            >

        </div>


        <div class="field">

            <label>
                Categoría
            </label>

            <select id="productCategory">
                <option value="camisetas">Camisetas</option>
                <option value="pantalones">Pantalones</option>
                <option value="conjuntos">Conjuntos</option>
                <option value="gorras">Gorras</option>
                <option value="gafas">Gafas</option>
                <option value="bisuteria">Bisutería</option>
            </select>

        </div>


        <div class="field">

            <label>
                Referencias automáticas
            </label>

            <input
                id="productRef"
                type="text"
                readonly
                placeholder="Se generan automáticamente"
            >

        </div>


        <div class="field">

            <label>
                Precio €
            </label>

            <input
                id="productPrice"
                type="number"
                min="0"
                step="0.01"
                value="35"
            >

        </div>


        <div class="field">

            <label>
                Stock
            </label>

            <input
                id="productStock"
                type="number"
                min="0"
                step="1"
                value="999"
            >

        </div>


        <div class="field">

            <label>
                WhatsApp
            </label>

            <input
                id="productWhatsapp"
                type="text"
                placeholder="34600000000"
            >

        </div>


        <div class="field full">

            <label>
                Descripción
            </label>

            <textarea
                id="productDescription"
                placeholder="Describe brevemente el producto..."
            ></textarea>

        </div>


        <div class="field">

            <label>
                Envío mínimo
            </label>

            <input
                id="shippingMin"
                type="text"
                value="3"
                placeholder="Ej: 3"
            >

        </div>


        <div class="field">

            <label>
                Envío máximo
