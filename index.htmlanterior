        id="zoomImage"
        src=""
        alt=""
    >

</div>


<div
    id="toast"
    class="toast"
></div>


<script>
"use strict";

/* =========================================================
   STRANGIS ADMIN — MOTOR V2
   Compatible con Products + products.js actual
   - Referencia automática de producto
   - Referencia automática por imagen
   - CRUD Supabase
   - Auth de administrador
   - Colores, múltiples fotos y tallas
   ========================================================= */

const SUPABASE_URL = "https://xbbjfatmdbxbuoqdrgoj.supabase.co";
const SUPABASE_PUBLISHABLE_KEY = "sb_publishable_M7ETdIWvj4nCQZ55i24Vpw_5Yc5Islk";
const PRODUCTS_TABLE = "Products";
const ADMIN_UID = "d37fcd4a-6549-499d-a881-020a30a5f189";

const adminSupabaseClient = window.supabase.createClient(
    SUPABASE_URL,
    SUPABASE_PUBLISHABLE_KEY,
    { auth:{ persistSession:true, autoRefreshToken:true, detectSessionInUrl:true } }
);

let variants = [];
let sizes = [];
let activeVariant = 0;
let activePhoto = 0;
let previewQty = 1;
let editingProductId = null;
let editingProductRef = "";
let pendingDelete = null;
let loadingProducts = false;

const CATEGORIES = ["camisetas","pantalones","conjuntos","gorras","gafas","bisuteria"];

function $(id){ return document.getElementById(id); }
function str(v){ return String(v ?? "").trim(); }
function esc(v){ return str(v).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#039;"); }
function escJS(v){ return str(v).replace(/\\/g,"\\\\").replace(/"/g,'\\"').replace(/\r/g,"").replace(/\n/g,"\\n"); }
function num(v,f=0){ const n=Number(v); return Number.isFinite(n)?n:f; }
function int(v,f=0){ return Math.max(0,Math.floor(num(v,f))); }
function parseJSON(v){
    if(typeof v !== "string") return v;
    const t=v.trim(); if(!t) return v;
    try{return JSON.parse(t);}catch{return v;}
}
function showToast(message,error=false){
    const t=$("toast"); if(!t) return;
    t.textContent=message; t.classList.toggle("error",!!error); t.classList.add("show");
    clearTimeout(showToast.timer); showToast.timer=setTimeout(()=>t.classList.remove("show"),3500);
}

/* =========================================================
   REFERENCIAS — NO SE ESCRIBEN MANUALMENTE
========================================================= */
function randomToken(){
    if(window.crypto?.randomUUID) return window.crypto.randomUUID().replace(/-/g,"").slice(0,8).toUpperCase();
    return Math.random().toString(36).slice(2,10).toUpperCase();
}
function generateProductReference(){ return `STR-${Date.now().toString(36).toUpperCase()}-${randomToken()}`; }
function generateImageReference(){ return `IMG-${Date.now().toString(36).toUpperCase()}-${randomToken()}`; }
function normalizeProductRef(v){ return str(v).toLowerCase(); }
function normalizeImageRef(v){ return str(v).toLowerCase(); }

function collectExistingRefs(){
    const productRefs=new Set(), imageRefs=new Set();
    return {productRefs,imageRefs};
}

function generateUniqueProductReference(){
    let ref;
    const current=collectExistingRefs();
    do { ref=generateProductReference(); } while(current.productRefs.has(normalizeProductRef(ref)));
    return ref;
}
function generateUniqueImageReference(used=new Set()){
    let ref;
    do { ref=generateImageReference(); } while(used.has(normalizeImageRef(ref)));
    used.add(normalizeImageRef(ref));
    return ref;
}

/* =========================================================
   NORMALIZACIÓN DE IMÁGENES
   El admin usa {url, ref} internamente y guarda el formato
   que espera el products.js actual: {name,image,ref}.
========================================================= */
function normalizeImageObject(item){
    if(typeof item === "string"){
        const url=str(item); return url ? {url,ref:""} : null;
    }
    if(!item || typeof item !== "object") return null;
    const url=str(item.url || item.image || item.src || item.image_url || item.imageUrl || item.photo || item.photo_url || item.photoUrl);
    if(!url) return null;
    return {url,ref:str(item.ref || item.reference || item.image_ref || item.imageReference)};
}

function normalizeVariants(raw){
    const parsed=parseJSON(raw);
    if(!Array.isArray(parsed)){
        const one=normalizeImageObject(parsed);
        return one ? [{name:"Principal",color:"#888888",images:[one]}] : [{name:"Principal",color:"#888888",images:[]}];
    }
    if(!parsed.length) return [{name:"Principal",color:"#888888",images:[]}];

    /* Formato antiguo/nuevo por colores: [{name,color,images:[...]}] */
    if(parsed.some(x=>x && typeof x==="object" && (Array.isArray(x.images) || x.color || x.name))){
        return parsed.map((v,i)=>{
            let ims=[];
            if(Array.isArray(v?.images)) ims=v.images.map(normalizeImageObject).filter(Boolean);
            else if(v?.image || v?.url || v?.src){ const im=normalizeImageObject(v); if(im) ims=[im]; }
            return {name:str(v?.name)||`Color ${i+1}`,color:str(v?.color)||"#888888",images:ims};
        });
    }

    /* Formato products.js actual: [{name,image,ref}, ...] */
    const images=parsed.map(normalizeImageObject).filter(Boolean);
    return [{name:"Principal",color:"#888888",images}];
}

function ensureImageRefs(){
    const used=new Set();
    variants.forEach(v=>{
        if(!Array.isArray(v.images)) v.images=[];
        v.images.forEach(im=>{
            if(!im || !im.url) return;
            const existing=normalizeImageRef(im.ref);
            if(existing && !used.has(existing)){ used.add(existing); im.ref=str(im.ref); }
            else im.ref=generateUniqueImageReference(used);
        });
    });
}

function flattenVariantsForProductsJS(){
    ensureImageRefs();
    return variants.flatMap(v=>
        (Array.isArray(v.images)?v.images:[])
            .filter(im=>im?.url)
            .map(im=>({name:v.name,image:im.url,ref:im.ref}))
    );
}

/* =========================================================
   AUTH
========================================================= */
function showAdmin(){ $("loginOverlay")?.classList.add("hidden"); if($("logoutButton")) $("logoutButton").style.display="block"; }
function hideAdmin(){ $("loginOverlay")?.classList.remove("hidden"); if($("logoutButton")) $("logoutButton").style.display="none"; }

async function verifyAdmin(){
    const {data,error}=await adminSupabaseClient.auth.getUser();
    if(error) throw error;
    if(!data?.user) throw new Error("No existe una sesión.");
    if(data.user.id !== ADMIN_UID){
        await adminSupabaseClient.auth.signOut();
        throw new Error("Este usuario no tiene permisos de administrador.");
    }
    return data.user;
}

async function loginAdmin(event){
    event.preventDefault();
    const email=$("loginEmail").value.trim(), password=$("loginPassword").value;
    const button=$("loginButton"), errorBox=$("loginError");
    errorBox.textContent="";
    if(!email||!password){errorBox.textContent="Introduce tu correo y contraseña.";return;}
    button.disabled=true; button.textContent="ENTRANDO...";
    try{
        const {data,error}=await adminSupabaseClient.auth.signInWithPassword({email,password});
        if(error) throw error;
        if(!data?.user) throw new Error("No se ha podido iniciar sesión.");
        await verifyAdmin(); showAdmin(); $("loginPassword").value=""; await loadProducts(); showToast("Sesión iniciada correctamente.");
    }catch(error){
        console.error(error); errorBox.textContent=error?.message||"Error al iniciar sesión.";
        try{await adminSupabaseClient.auth.signOut();}catch(_){ }
    }finally{button.disabled=false;button.textContent="ENTRAR";}
}
async function logoutAdmin(){
    try{await adminSupabaseClient.auth.signOut();}catch(e){console.error(e);}
    editingProductId=null; editingProductRef=""; hideAdmin(); showToast("Sesión cerrada.");
}
async function checkSession(){
    try{
        const {data,error}=await adminSupabaseClient.auth.getSession(); if(error) throw error;
        if(!data?.session){hideAdmin();return;}
        await verifyAdmin(); showAdmin(); await loadProducts();
    }catch(error){console.error(error);hideAdmin();}
}
adminSupabaseClient.auth.onAuthStateChange((event,session)=>{ if(!session) hideAdmin(); });

/* =========================================================
   PRODUCTOS
========================================================= */
async function loadProducts(){
    if(loadingProducts) return; loadingProducts=true;
    const container=$("productsList");
    container.innerHTML='<div class="products-loading">Cargando productos...</div>';
    try{
        await verifyAdmin();
        const {data,error}=await adminSupabaseClient.from(PRODUCTS_TABLE).select("*").order("id",{ascending:false});
        if(error) throw error;
        if(!data?.length){container.innerHTML='<div class="products-empty">No hay productos guardados todavía.</div>';return;}
        container.innerHTML=data.map(renderProductAdmin).join("");
    }catch(error){
        console.error(error);
        container.innerHTML=`<div class="products-empty">❌ No se pudieron cargar los productos.<br><br>${esc(error.message)}</div>`;
    }finally{loadingProducts=false;}
}
function getProductImagesForAdmin(product){
    const raw=parseJSON(product?.images);
    if(Array.isArray(raw)){
        /* Nested colors */
        if(raw.some(x=>x && typeof x==="object" && Array.isArray(x.images))){
            return raw.flatMap(v=>(Array.isArray(v.images)?v.images:[]).map(normalizeImageObject).filter(Boolean));
        }
        return raw.map(normalizeImageObject).filter(Boolean);
    }
    const one=normalizeImageObject(raw); return one?[one]:[];
}
function renderProductAdmin(product){
    const imgs=getProductImagesForAdmin(product), first=imgs[0]?.url||"";
    const price=num(product.price,0);
    return `<div class="product-admin-item">
        <div class="product-admin-image">${first?`<img src="${esc(first)}" alt="${esc(product.name)}" onerror="this.style.display='none'">`:""}</div>
        <div>
            <div class="product-admin-name">${esc(product.name||"Producto sin nombre")}</div>
            <div class="product-admin-meta">REF: ${esc(product.ref||"—")} · ${price.toLocaleString("es-ES",{style:"currency",currency:"EUR"})} · Stock: ${esc(product.stock??0)} · ${esc(str(product.category)||"—")} · ${imgs.length} ${imgs.length===1?"foto":"fotos"}</div>
            <div class="product-admin-id">ID: ${esc(product.id)}</div>
        </div>
        <div class="product-admin-actions">
            <button type="button" class="btn btn-small" data-edit-id="${esc(product.id)}">✏ EDITAR</button>
            <button type="button" class="btn btn-small btn-danger" data-delete-id="${esc(product.id)}" data-delete-name="${esc(product.name||"Producto sin nombre")}">🗑 ELIMINAR</button>
        </div>
    </div>`;
}

/* =========================================================
   EDITAR / NUEVO
========================================================= */
async function editProduct(productId){
    try{
        await verifyAdmin();
        const {data,error}=await adminSupabaseClient.from(PRODUCTS_TABLE).select("*").eq("id",productId).single();
        if(error) throw error; if(!data) throw new Error("No se encontró el producto.");
        editingProductId=data.id; editingProductRef=str(data.ref)||generateUniqueProductReference();
        $("productName").value=data.name||""; $("productCategory").value=CATEGORIES.includes(str(data.category).toLowerCase())?str(data.category).toLowerCase():"camisetas";
        $("productRef").value=editingProductRef; $("productPrice").value=data.price??0; $("productStock").value=data.stock??0; $("productWhatsapp").value=data.whatsapp||""; $("productDescription").value=data.description||"";
        $("shippingMin").value=data.shipping_min??3; $("shippingMax").value=data.shipping_max??9;
        const rawSizes=parseJSON(data.sizes); sizes=Array.isArray(rawSizes)?rawSizes.map(str).filter(Boolean):(typeof rawSizes==="string"?rawSizes.split(",").map(str).filter(Boolean):[]);
        variants=normalizeVariants(data.images); ensureImageRefs(); activeVariant=0; activePhoto=0; previewQty=1;
        renderVariants();renderSizes();updatePreview();
        $("editModeBar").classList.add("show");$("editModeTitle").textContent="Editando: "+(data.name||"Producto");$("editModeId").textContent="ID: "+data.id;$("saveButton").textContent="ACTUALIZAR PRODUCTO";
        window.scrollTo({top:0,behavior:"smooth"});
    }catch(error){console.error(error);showToast("No se pudo cargar el producto: "+error.message,true);}
}
function newProduct(){
    editingProductId=null; editingProductRef=generateUniqueProductReference();
    variants=[{name:"Principal",color:"#888888",images:[]}]; sizes=["S","M","L","XL"]; activeVariant=0;activePhoto=0;previewQty=1;
    $("productName").value="";$("productCategory").value="camisetas";$("productRef").value=editingProductRef;$("productPrice").value="35";$("productStock").value="999";$("productWhatsapp").value="";$("productDescription").value="";$("shippingMin").value="3";$("shippingMax").value="9";$("codeOutput").value="";
    $("editModeBar").classList.remove("show");$("saveButton").textContent="GUARDAR EN SUPABASE";renderVariants();renderSizes();updatePreview();
}

/* =========================================================
   VARIANTES E IMÁGENES
========================================================= */
function renderVariants(){
    const container=$("variantsList"); if(!container)return;
    container.innerHTML=variants.map((variant,index)=>{
        const images=Array.isArray(variant.images)?variant.images:[];
        return `<div class="variant">
            <div class="variant-top">
                <div class="color-picker" style="background:${esc(variant.color||"#ffffff")}"><input type="color" value="${esc(variant.color||"#ffffff")}" data-color-index="${index}"></div>
                <div class="field"><label>Nombre del color</label><input type="text" value="${esc(variant.name)}" data-name-index="${index}" placeholder="Ej: Negro"><div style="margin-top:7px;color:#999;font-size:9px;letter-spacing:.5px">Las referencias de las fotos se generan automáticamente.</div></div>
                <button type="button" class="btn btn-small btn-danger" data-remove-variant="${index}">ELIMINAR COLOR</button>
            </div>
            <div class="variant-image-list">
                ${images.map((image,imageIndex)=>`<div class="variant-image-row">
                    <div class="field"><label>Foto ${imageIndex+1}</label><input type="url" value="${esc(image?.url||"")}" data-image-variant="${index}" data-image-index="${imageIndex}" placeholder="https://..."><div style="margin-top:5px;color:#999;font-size:9px">REF IMAGEN: ${esc(image?.ref||"Se generará al guardar")}</div></div>
                    <div class="variant-preview">${image?.url?`<img src="${esc(image.url)}" alt="" onerror="this.style.display='none'">`:""}</div>
                    <button type="button" class="btn btn-small btn-danger" data-remove-photo-variant="${index}" data-remove-photo-index="${imageIndex}">×</button>
                </div>`).join("")}
            </div>
            <button type="button" class="btn btn-small add-photo" data-add-photo="${index}">+ AÑADIR FOTO</button>
        </div>`;
    }).join("");
    updatePreview();
}
function renderSizes(){
    const c=$("sizesList"); if(!c)return;
    c.innerHTML=sizes.map((size,index)=>`<div class="size-item"><input type="text" value="${esc(size)}" data-size-index="${index}"><button type="button" class="remove-size" data-remove-size="${index}">×</button></div>`).join("");
    updatePreview();
}
function addVariant(){ variants.push({name:`Color ${variants.length+1}`,color:"#888888",images:[]});activeVariant=variants.length-1;activePhoto=0;renderVariants(); }
function addPhoto(index){ if(!variants[index])return; if(!Array.isArray(variants[index].images))variants[index].images=[]; variants[index].images.push({url:"",ref:""});activeVariant=index;activePhoto=variants[index].images.length-1;renderVariants(); }

/* =========================================================
   DATOS / VALIDACIÓN
========================================================= */
function getProductData(){
    const name=str($("productName")?.value), category=str($("productCategory")?.value).toLowerCase();
    const price=num($("productPrice")?.value,0), stock=int($("productStock")?.value,0), description=str($("productDescription")?.value);
    const whatsapp=str($("productWhatsapp")?.value).replace(/\D/g,""); const shippingMin=num($("shippingMin")?.value,3), shippingMax=num($("shippingMax")?.value,9);
    if(!name){showToast("Introduce el nombre del producto.",true);return null;}
    if(!CATEGORIES.includes(category)){showToast("Selecciona una categoría válida.",true);return null;}
    if(price<0||stock<0){showToast("El precio y el stock no pueden ser negativos.",true);return null;}
    if(shippingMin<0||shippingMax<0||shippingMin>shippingMax){showToast("Revisa el rango de envío.",true);return null;}
    if(!variants.length){showToast("Añade al menos un color.",true);return null;}
    for(const v of variants){
        v.name=str(v.name); if(!v.name){showToast("Todos los colores necesitan un nombre.",true);return null;}
        const validImages=(v.images||[]).filter(im=>str(im?.url)); if(!validImages.length){showToast(`El color "${v.name}" necesita al menos una foto.`,true);return null;}
    }
    ensureImageRefs();
    const ref=str($("productRef")?.value)||editingProductRef||generateUniqueProductReference();
    $("productRef").value=ref; editingProductRef=ref;
    return {name,category,ref,price,stock,description,whatsapp,images:flattenVariantsForProductsJS(),sizes:sizes.map(str).filter(Boolean),shipping_min:shippingMin,shipping_max:shippingMax,active:true};
}

/* =========================================================
   CÓDIGO GENERADO — usa exactamente el formato products.js
========================================================= */
function generateCode(){
    const product=getProductData(); if(!product)return;
    const imageCode=product.images.map(im=>`        { name: "${escJS(im.name)}", image: "${escJS(im.image)}", ref: "${escJS(im.ref)}" }`).join(",\n");
    const code=`const product = {\n    name: "${escJS(product.name)}",\n    category: "${escJS(product.category)}",\n    ref: "${escJS(product.ref)}",\n    price: ${product.price},\n    stock: ${product.stock},\n    description: "${escJS(product.description)}",\n    whatsapp: "${escJS(product.whatsapp)}",\n    images: [\n${imageCode}\n    ],\n    sizes: ${JSON.stringify(product.sizes)},\n    shipping_min: ${product.shipping_min},\n    shipping_max: ${product.shipping_max},\n    active: true\n};`;
    $("codeOutput").value=code; return code;
}

/* =========================================================
   GUARDAR / ACTUALIZAR
========================================================= */
async function saveProductToSupabase(){
    const product=getProductData(); if(!product)return;
    const button=$("saveButton"), wasEditing=editingProductId!==null; button.disabled=true;button.textContent=wasEditing?"ACTUALIZANDO...":"GUARDANDO...";
    try{
        await verifyAdmin();
        let data,error;
        if(wasEditing){
            ({data,error}=await adminSupabaseClient.from(PRODUCTS_TABLE).update(product).eq("id",editingProductId).select().single());
        }else{
            ({data,error}=await adminSupabaseClient.from(PRODUCTS_TABLE).insert(product).select().single());
        }
        if(error) throw error; if(!data)throw new Error("Supabase no devolvió el producto.");
        editingProductId=data.id; editingProductRef=str(data.ref)||product.ref; $("productRef").value=editingProductRef;
        $("editModeBar").classList.add("show");$("editModeTitle").textContent="Editando: "+(data.name||"Producto");$("editModeId").textContent="ID: "+data.id;$("saveButton").textContent="ACTUALIZAR PRODUCTO";
        generateCode(); await loadProducts(); showToast(wasEditing?"Producto actualizado correctamente.":"Producto creado correctamente.");
    }catch(error){
        console.error(error);
        let msg=error?.message||"Error desconocido.";
        if(error?.code==="23505")msg="Ya existe una referencia igual en Supabase.";
        showToast("No se pudo guardar: "+msg,true);
    }finally{button.disabled=false;button.textContent=editingProductId!==null?"ACTUALIZAR PRODUCTO":"GUARDAR EN SUPABASE";}
}

/* =========================================================
   ELIMINAR
========================================================= */
function openDeleteModal(id,name){pendingDelete={id,name};$("deleteProductName").textContent=name;$("deleteModal").classList.add("show");document.body.style.overflow="hidden";}
function closeDeleteModal(){pendingDelete=null;$("deleteModal").classList.remove("show");document.body.style.overflow="";}
async function confirmDeleteProduct(){
    if(!pendingDelete)return; const item=pendingDelete,button=$("confirmDeleteButton");button.disabled=true;button.textContent="ELIMINANDO...";
    try{
        await verifyAdmin(); const {data,error}=await adminSupabaseClient.from(PRODUCTS_TABLE).delete().eq("id",item.id).select();
        if(error)throw error; if(!data?.length)throw new Error("No se eliminó ninguna fila. Comprueba las políticas RLS y el ID del producto.");
        if(editingProductId!==null&&String(editingProductId)===String(item.id))newProduct();
        closeDeleteModal();await loadProducts();showToast("Producto eliminado correctamente.");
    }catch(error){console.error(error);showToast("No se pudo eliminar: "+error.message,true);}finally{button.disabled=false;button.textContent="ELIMINAR PRODUCTO";}
}

/* =========================================================
   PREVISUALIZACIÓN
========================================================= */
function updatePreview(){
    const name=str($("productName")?.value), price=num($("productPrice")?.value,0), desc=str($("productDescription")?.value), a=str($("shippingMin")?.value), b=str($("shippingMax")?.value);
    $("previewName").textContent=name||"Nombre del producto";$("previewRef").textContent="REF: "+(variants[activeVariant]?.images?.[activePhoto]?.ref||$("productRef")?.value||"—");$("previewDescription").textContent=desc||"Descripción del producto";$("previewPrice").textContent=price.toLocaleString("es-ES",{style:"currency",currency:"EUR"});$("previewShipping").textContent=a&&b?`${a} – ${b} días`:"Indica los días de envío";
    renderPreviewVariants();renderPreviewSizes();
}
function renderPreviewVariants(){
    const c=$("previewColors"); if(!variants.length){c.innerHTML="";return;} if(activeVariant>=variants.length)activeVariant=variants.length-1; const active=variants[activeVariant];
    c.innerHTML=variants.map((v,i)=>{const first=v.images?.find(im=>str(im?.url))?.url||"";let style=`background-color:${esc(v.color||"#fff")}`;if(first)style+=`;background-image:url("${esc(first)}")`;return `<button type="button" class="preview-color ${i===activeVariant?"active":""}" style="${style}" data-preview-variant="${i}" title="${esc(v.name)}"></button>`;}).join("");
    $("previewColorName").textContent=active?.name||"—";
    const images=(active?.images||[]).filter(im=>str(im?.url)); if(activePhoto>=images.length)activePhoto=0; const image=$("previewImage"),counter=$("photoCounter");
    if(images.length){image.src=images[activePhoto].url;image.alt=active.name||"";image.style.display="block";counter.style.display="block";counter.textContent=`${activePhoto+1} / ${images.length}`;}else{image.removeAttribute("src");image.style.display="none";counter.style.display="none";}
    $("previewThumbs").innerHTML=images.map((im,i)=>`<button type="button" class="preview-thumb ${i===activePhoto?"active":""}" data-preview-photo="${i}"><img src="${esc(im.url)}" alt="" onerror="this.style.display='none'"></button>`).join("");
}
function renderPreviewSizes(){ $("previewSizes").innerHTML=sizes.filter(str).map((s,i)=>`<button type="button" class="preview-size ${i===0?"active":""}">${esc(s)}</button>`).join(""); }
function selectPreviewVariant(i){if(!variants[i])return;activeVariant=i;activePhoto=0;renderPreviewVariants();updatePreview();}
function selectPreviewPhoto(i){if(!variants[activeVariant]?.images?.[i]?.url)return;activePhoto=i;renderPreviewVariants();updatePreview();}
function nextPreviewImage(){const n=(variants[activeVariant]?.images||[]).filter(im=>str(im?.url)).length;if(n>1){activePhoto=(activePhoto+1)%n;renderPreviewVariants();}}
function previousPreviewImage(){const n=(variants[activeVariant]?.images||[]).filter(im=>str(im?.url)).length;if(n>1){activePhoto=(activePhoto-1+n)%n;renderPreviewVariants();}}
function changePreviewQuantity(delta){previewQty=Math.max(1,previewQty+delta);const stock=int($("productStock")?.value,0);if(stock>0)previewQty=Math.min(previewQty,stock);$("previewQuantity").textContent=previewQty;}
function openZoom(){const src=$("previewImage")?.src;if(!src||$("previewImage").style.display==="none")return;$("zoomImage").src=src;$("zoomModal").classList.add("show");document.body.style.overflow="hidden";}
function closeZoom(){$("zoomModal").classList.remove("show");$("zoomImage").removeAttribute("src");document.body.style.overflow="";}

/* =========================================================
   EVENTOS
========================================================= */
$("loginForm").addEventListener("submit",loginAdmin);
$("logoutButton").addEventListener("click",logoutAdmin);
$("refreshProductsButton").addEventListener("click",loadProducts);
$("newProductButton").addEventListener("click",newProduct);
$("newFromEditButton").addEventListener("click",newProduct);
$("addVariantButton").addEventListener("click",addVariant);
$("addSizeButton").addEventListener("click",()=>{sizes.push("");renderSizes();});
$("saveButton").addEventListener("click",saveProductToSupabase);
$("generateCodeButton").addEventListener("click",generateCode);
$("copyCodeButton").addEventListener("click",async()=>{const code=$("codeOutput").value;if(!code){showToast("Primero genera el código.",true);return;}try{await navigator.clipboard.writeText(code);showToast("Código copiado.");}catch{ $("codeOutput").select();document.execCommand("copy");showToast("Código copiado.");}});
$("previousPhotoButton").addEventListener("click",previousPreviewImage);
$("nextPhotoButton").addEventListener("click",nextPreviewImage);
$("quantityMinus").addEventListener("click",()=>changePreviewQuantity(-1));
$("quantityPlus").addEventListener("click",()=>changePreviewQuantity(1));
$("previewImage").addEventListener("click",openZoom);
$("zoomCloseButton").addEventListener("click",closeZoom);
$("cancelDeleteButton").addEventListener("click",closeDeleteModal);
$("confirmDeleteButton").addEventListener("click",confirmDeleteProduct);

["productName","productCategory","productPrice","productStock","productWhatsapp","productDescription","shippingMin","shippingMax"].forEach(id=>$(id).addEventListener("input",()=>{updatePreview();}));

$("variantsList").addEventListener("input",event=>{
    const t=event.target;
    if(t.dataset.nameIndex!==undefined){const i=Number(t.dataset.nameIndex);if(variants[i]){variants[i].name=t.value;updatePreview();}}
    if(t.dataset.imageVariant!==undefined){const vi=Number(t.dataset.imageVariant),ii=Number(t.dataset.imageIndex);if(variants[vi]?.images?.[ii]){variants[vi].images[ii].url=t.value;activeVariant=vi;activePhoto=ii;updatePreview();}} 
});
$("variantsList").addEventListener("change",event=>{const t=event.target;if(t.dataset.colorIndex!==undefined){const i=Number(t.dataset.colorIndex);if(variants[i]){variants[i].color=t.value;renderVariants();}}});
$("sizesList").addEventListener("input",event=>{const t=event.target;if(t.dataset.sizeIndex!==undefined)sizes[Number(t.dataset.sizeIndex)]=t.value;updatePreview();});

document.addEventListener("click",event=>{
    const t=event.target;
    const edit=t.closest("[data-edit-id]");if(edit){editProduct(edit.dataset.editId);return;}
    const del=t.closest("[data-delete-id]");if(del){openDeleteModal(del.dataset.deleteId,del.dataset.deleteName);return;}
    const remV=t.closest("[data-remove-variant]");if(remV){const i=Number(remV.dataset.removeVariant);if(variants.length<=1){showToast("Debe existir al menos un color.",true);return;}variants.splice(i,1);activeVariant=Math.min(activeVariant,variants.length-1);activePhoto=0;renderVariants();return;}
    const addP=t.closest("[data-add-photo]");if(addP){addPhoto(Number(addP.dataset.addPhoto));return;}
    const remP=t.closest("[data-remove-photo-variant]");if(remP){const vi=Number(remP.dataset.removePhotoVariant),ii=Number(remP.dataset.removePhotoIndex),ims=variants[vi]?.images;if(!ims)return;ims.splice(ii,1);activeVariant=vi;activePhoto=0;renderVariants();return;}
    const remS=t.closest("[data-remove-size]");if(remS){sizes.splice(Number(remS.dataset.removeSize),1);renderSizes();return;}
    const pv=t.closest("[data-preview-variant]");if(pv){selectPreviewVariant(Number(pv.dataset.previewVariant));return;}
    const pp=t.closest("[data-preview-photo]");if(pp){selectPreviewPhoto(Number(pp.dataset.previewPhoto));return;}
});

$("zoomModal").addEventListener("click",e=>{if(e.target.id==="zoomModal")closeZoom();});
$("deleteModal").addEventListener("click",e=>{if(e.target.id==="deleteModal")closeDeleteModal();});
document.addEventListener("keydown",e=>{if(e.key==="Escape"){closeZoom();closeDeleteModal();}const tag=document.activeElement?.tagName;if(tag==="INPUT"||tag==="TEXTAREA"||tag==="SELECT")return;if(e.key==="ArrowRight")nextPreviewImage();if(e.key==="ArrowLeft")previousPreviewImage();});

newProduct();
checkSession();
console.log("STRANGIS ADMIN V2 — Supabase conectado:",SUPABASE_URL);
</script>
</body>
</html>
